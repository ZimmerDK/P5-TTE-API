# Copy this file to .env and select the model to run.
MODEL_DIR=models
# MODEL_NAME SUPPORTED VALUES: DecisionTreeRegressor, LinearRegression, 
# RandomForestRegressor, Ridge, XGBRegressor
MODEL_NAME=XGBRegressor
# MODEL_PATH takes precedence over MODEL_DIR and MODEL_NAME. Commented out by default, but can be used to specify a custom model path.
# MODEL_PATH=models/XGBRegressor.json
#
# MODEL_FEATURES specifies explicit features to pass to the model.
# Commented out by default so it automatically uses model.feature_names_in_ or feature_order.json.
# MODEL_FEATURES=matched_length_m,hour,minute,day_of_week,month,speed_limit_kmh,density,lane_count,bridge,tunnel,roundabout,internal_intersection

# Context microservice settings (used by ASP.NET API)
Context__Enabled=false
Context__BaseUrl=http://localhost:8010/
# Set this in ml-service\.env; do not commit the API key.
# Context__ApiKey=
Context__DefaultYear=2020
#Context__RadiusMeters=500
#Context__RoadNetwork=denmark_2026
#Context__FeatureKey=road_density

# Google Maps Platform settings (used by the ASP.NET API).
# Keep the real key only in ml-service\.env; never commit it.
# GoogleMaps__ApiKey=
