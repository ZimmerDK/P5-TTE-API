{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Model": {
    "UsePlaceholder": true,
    "ModelPath": "best_model.onnx",
    "PlaceholderAverageSpeedKmh": 40,
    "PlaceholderWaypointDelaySeconds": 0
  },
  "Osm": {
    "UseOsrm": false,
    "GeocodingUrl": "https://nominatim.openstreetmap.org/search",
    "RoutingUrl": "https://router.project-osrm.org/route/v1/driving"
  },
  "Valhalla": {
    "Enabled": false,
    "Endpoint": "http://localhost:8002/route",
    "GeocodingUrl": "https://nominatim.openstreetmap.org/search"
  },
  "MapCache": {
    "Enabled": false,
    "Directory": "map-cache",
    "UpdateIntervalHours": 168,
    "Regions": []
  },
  "GoogleRoutes": {
    "ApiKey": "",
    "Endpoint": "https://routes.googleapis.com/directions/v2:computeRoutes"
  },
  "AllowedHosts": "*"
}
