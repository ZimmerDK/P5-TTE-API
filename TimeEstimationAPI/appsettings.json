{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Api": {
    "PrettyPrintJson": true
  },
  "Model": {
    "PythonServiceUrl": "http://localhost:8001",
    "PythonServiceTimeoutSeconds": 30
  },
  "Osm": {
    "UseOsrm": false,
    "UseOverpass": false,
    "GeocodingUrl": "https://nominatim.openstreetmap.org/search",
    "RoutingUrl": "https://router.project-osrm.org/route/v1/driving",
    "OverpassUrl": "https://overpass.kumi.systems/api/interpreter"
  },
  "Context": {
    "Enabled": false,
    "BaseUrl": "http://localhost:8010/",
    "RadiusMeters": 500,
    "DefaultYear": 2020,
    "RoadNetwork": "denmark_2026",
    "FeatureKey": "road_density"
  },
  "Valhalla": {
    "Enabled": false,
    "Endpoint": "http://localhost:8002/route",
    "GeocodingUrl": "https://nominatim.openstreetmap.org/search"
  },
  "GoogleMaps": {
    "Enabled": false,
    "RoutesUrl": "https://routes.googleapis.com/directions/v2:computeRoutes"
  },
  "AllowedHosts": "*"
}
