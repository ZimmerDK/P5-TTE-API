@apiBaseUrl = http://localhost:5073
@pythonBaseUrl = http://127.0.0.1:8001

# ==========================================
# Python Model Service
# ==========================================

### Python Health Check
GET {{pythonBaseUrl}}/health

### Python Model Info
GET {{pythonBaseUrl}}/model-info

### Predict Route Time (Python Service)
POST {{pythonBaseUrl}}/predict
Content-Type: application/json

{
  "modelName": "route_time_model_v1",
  "segmentFeatures": [
    {
      "matched_length_m": 67,
      "hour": 8,
      "minute": 30,
      "day_of_week": 3,
      "month": 10,
      "speed_limit_kmh": 50,
      "density": 0,
      "lane_count": 2,
      "bridge": 0,
      "tunnel": 0,
      "roundabout": 0,
      "internal_intersection": 1
    },
    {
      "matched_length_m": 42,
      "hour": 8,
      "minute": 31,
      "day_of_week": 3,
      "month": 10,
      "speed_limit_kmh": 110,
      "density": 0,
      "lane_count": 3,
      "bridge": 1,
      "tunnel": 0,
      "roundabout": 0,
      "internal_intersection": 0
    },
    {
      "matched_length_m": 150,
      "hour": 8,
      "minute": 32,
      "day_of_week": 3,
      "month": 10,
      "speed_limit_kmh": 80,
      "density": 0,
      "lane_count": 2,
      "bridge": 0,
      "tunnel": 0,
      "roundabout": 1,
      "internal_intersection": 0
    }
  ],
  "routeFeatures": {},
  "timeFeatures": {}
}

# ==========================================
# Route API (ASP.NET Service)
# ==========================================

### API Health Check
GET {{apiBaseUrl}}/health

### Estimate Route (Short Local Route: Aalborg Station to Utzon Center ~10-15 segments)
POST {{apiBaseUrl}}/api/routes/estimate
Content-Type: application/json

{
  "source": "Aalborg Station, Denmark",
  "destination": "Utzon Center, Aalborg, Denmark",
  "via": [],
  "departureTime": "2026-10-22T08:30:00+02:00",
  "mode": "car"
}

### Estimate Route (Urban Short Route: Aalborg Station to Aalborg University)
POST {{apiBaseUrl}}/api/routes/estimate
Content-Type: application/json

{
  "source": "Aalborg Station, Denmark",
  "destination": "Aalborg Universitet, Denmark",
  "via": [],
  "departureTime": "2026-10-22T08:30:00+02:00",
  "mode": "car"
}

### Estimate Route (Urban Short Route: Copenhagen Central to Nyhavn)
POST {{apiBaseUrl}}/api/routes/estimate
Content-Type: application/json

{
  "source": "København H, Copenhagen",
  "destination": "Nyhavn, Copenhagen",
  "via": [],
  "departureTime": "2026-10-22T08:30:00+02:00",
  "mode": "car"
}

### Estimate Route with Provider and Model (Intercity: Stockholm to Gothenburg)
POST {{apiBaseUrl}}/api/routes/estimate
Content-Type: application/json

{
  "source": "Stockholm",
  "destination": "Gothenburg",
  "via": [],
  "departureTime": "2026-10-22T08:30:00+02:00",
  "mode": "car"
}

### Provider Route Data and OSM Enrichment Only
POST {{apiBaseUrl}}/api/routes/provider-data
Content-Type: application/json

{
  "source": "Stockholm",
  "destination": "Gothenburg",
  "via": [],
  "departureTime": "2026-10-22T08:30:00+02:00",
  "mode": "car"
}

### Model-only Estimate from Explicit Segments
POST {{apiBaseUrl}}/api/routes/model-only
Content-Type: application/json

{
  "segments": [
    {
      "lengthMeters": 67,
      "roadType": "residential",
      "speedLimitKmh": 50,
      "laneCount": 2,
      "isRoundabout": false,
      "hasTrafficSignal": true,
      "isIntersection": true,
      "isBridge": false,
      "isTunnel": false
    },
    {
      "lengthMeters": 42,
      "roadType": "motorway",
      "speedLimitKmh": 110,
      "laneCount": 3,
      "isRoundabout": false,
      "hasTrafficSignal": false,
      "isIntersection": false,
      "isBridge": true,
      "isTunnel": false
    },
    {
      "lengthMeters": 150,
      "roadType": "primary",
      "speedLimitKmh": 80,
      "laneCount": 2,
      "isRoundabout": true,
      "hasTrafficSignal": false,
      "isIntersection": false,
      "isBridge": false,
      "isTunnel": false
    }
  ],
  "departureTime": "2026-10-22T08:30:00+02:00",
  "mode": "car"
}

### Invalid Estimate Validation Check
POST {{apiBaseUrl}}/api/routes/estimate
Content-Type: application/json

{
  "source": "",
  "destination": "",
  "via": [],
  "departureTime": "2026-09-24T08:30:00Z",
  "mode": "car"
}