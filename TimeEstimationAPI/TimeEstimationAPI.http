@baseUrl = http://localhost:5073

### Health
GET {{baseUrl}}/health

### Estimate route
POST {{baseUrl}}/api/routes/estimate
Content-Type: application/json

{
  "source": "Stockholm",
  "destination": "Gothenburg",
  "via": [],
  "departureTime": "2026-10-22T08:30:00+02:00",
  "mode": "car"
}

### Estimate an explicitly supplied segment route
POST {{baseUrl}}/api/routes/estimate
Content-Type: application/json

{
  "source": "Segment route start",
  "destination": "Segment route end",
  "via": [],
  "segments": [
    {
      "lengthMeters": 1000,
      "roadType": "primary",
      "speedLimitKmh": 50,
      "laneCount": 2,
      "isRoundabout": false,
      "hasTrafficSignal": true,
      "isIntersection": true
    },
    {
      "lengthMeters": 500,
      "roadType": "secondary",
      "speedLimitKmh": 30,
      "laneCount": 1,
      "isRoundabout": true,
      "hasTrafficSignal": false,
      "isIntersection": true
    }
  ],
  "departureTime": "2026-10-22T08:30:00+02:00",
  "mode": "car"
}

### Invalid estimate
POST {{baseUrl}}/api/routes/estimate
Content-Type: application/json

{
  "source": "",
  "destination": "",
  "via": [],
  "departureTime": "2026-09-24T08:30:00Z",
  "mode": "car"
}
