@baseUrl = http://localhost:5073

### Health
GET {{baseUrl}}/health

### Estimate route
POST {{baseUrl}}/api/routes/estimate
Content-Type: application/json

{
  "source": "A",
  "destination": "B",
  "via": ["C", "D"],
  "departureTime": "2026-09-24T08:30:00Z",
  "mode": "car"
}

### Invalid estimate
POST {{baseUrl}}/api/routes/estimate
Content-Type: application/json

{
  "source": "",
  "destination": "",
  "via": [],
  "departureTime": "2026-09-24T08:30:00Z",
  "mode": "car"
}
